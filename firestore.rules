rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 管理員：admins 底下有「uid」或「已驗證的 Email」為文件 ID 的資料
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(db)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email_verified == true && request.auth.token.email != null &&
          exists(/databases/$(db)/documents/admins/$(request.auth.token.email))));
    }
    function str(v, max) { return v is string && v.size() <= max; }

    // 學員送出預約：任何人可新增，但欄位要對
    match /bookings/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['goals','level','who','people','date','time','name','phone','lineId','note','status','createdAt','lineUserId','lineName'])
        && (!('lineUserId' in request.resource.data) || request.resource.data.lineUserId.matches('^U[0-9a-f]{32}$'))
        && (!('lineName' in request.resource.data) || str(request.resource.data.lineName, 50))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && str(request.resource.data.name, 30) && request.resource.data.name.size() > 0
        && str(request.resource.data.phone, 20) && request.resource.data.phone.size() >= 8
        && str(request.resource.data.lineId, 40)
        && str(request.resource.data.note, 500)
        && str(request.resource.data.level, 20) && str(request.resource.data.who, 20)
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.people is int && request.resource.data.people >= 1 && request.resource.data.people <= 3
        && request.resource.data.goals is list && request.resource.data.goals.size() <= 10;
      allow read, update, delete: if isAdmin();
    }

    // 已確認的時段（只有日期時間，沒有個資）：公開讀，教練寫
    match /busy/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 網站內容（課表、聯絡方式、預約設定）：公開讀，教練在後台改
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'config';
    }

    // 學員名冊、扣堂紀錄、課表：只有管理員
    match /students/{sid} {
      allow read, write: if isAdmin();
      match /ledger/{lid} { allow read, write: if isAdmin(); }
    }
    match /lessons/{lid} {
      allow read, write: if isAdmin();
    }
    match /packages/{id} { allow read: if true; allow write: if isAdmin(); } // 學員 App 顯示方案價格
    match /notify/{id} { allow read, write: if isAdmin(); } // LINE 通知名單（Functions 寫入）
    match /sales/{id} { allow read, write: if isAdmin(); }
    match /media/{id} { allow read, write: if isAdmin(); } // 媒體庫（後台用；網站顯示的網址存在 site/config）

    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.email == uid);
      allow write: if false;
    }
  }
}
