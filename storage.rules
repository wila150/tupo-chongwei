rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 後台上傳的網站照片：公開讀，只有 Firestore admins/{uid} 有資料的帳號能寫
    // 固定位置的相簿：photos/albums/<位置>/<時間>.webp
    match /photos/albums/{slot}/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
            || (request.auth.token.email_verified == true && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))))
        && slot in ['coach', 'g1', 'g2', 'g3', 'hero'] && file.matches('[0-9a-z]+\\.webp')
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
    match /photos/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
            || (request.auth.token.email_verified == true && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))))
        && file.matches('(coach|g1|g2|g3|hero)\\.webp')
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
